# SPDX-License-Identifier: GPL-2.0
#
# crownlte (SM-N960F, Exynos 9810) Android 16 / LineageOS 23 additions.
#
# Input to scripts/kconfig/merge_config.sh on top of the hardware-verified
# diagnostic config (build/acpm-tmu-6.12.93/.config @ crownlte-acpm-tmu 2ac3a7454
# + the CPU_FREQ_STAT/GOV_POWERSAVE/GOV_USERSPACE additions from crownlte-cpufreq).
# The generated, self-contained result is crownlte_android_defconfig; regenerate
# it with Documentation/crownlte/android-config.txt.
#
# Sources: this tree's gki_defconfig (android16-6.12), the AOSP kernel/configs
# android-base / android-base-conditional / android-recommended requirements
# (reconstructed: this tree has no kernel/configs/android-*.config), the running
# 4.9 config (/root/crownlte-hid-kernel/out/.config) and the Lineage 23 sepolicy
# device nodes (plat/vendor_file_contexts).
#
# Policy: built-in only (CONFIG_MODULES stays off; nothing here needs a module).
# Nothing in this file binds to an Exynos 9810 hardware block that the
# diagnostic DT does not already describe; options that would are kept off and
# listed at the end.

CONFIG_LOCALVERSION="-crownlte-android"

# --- Scheduler, timers, preemption (android-base) -------------------------
# Full preemption as in GKI/4.9. PREEMPT_DYNAMIC lets a trial fall back to the
# hardware-verified model with "preempt=none" on the command line.
CONFIG_PREEMPT=y
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_IRQ_TIME_ACCOUNTING=y
CONFIG_SCHED_MC=y
CONFIG_ENERGY_MODEL=y
CONFIG_UCLAMP_BUCKETS_COUNT=20

# --- Accounting / stats used by storaged, lmkd, batterystats --------------
CONFIG_TASKSTATS=y
CONFIG_TASK_DELAY_ACCT=y
CONFIG_TASK_XACCT=y
CONFIG_TASK_IO_ACCOUNTING=y
CONFIG_PSI=y
CONFIG_UID_SYS_STATS=y
CONFIG_CPU_FREQ_TIMES=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y

# --- cgroups (init task_profiles / cgroups.json) ---------------------------
CONFIG_CPUSETS=y
CONFIG_CPUSETS_V1=y
CONFIG_MEMCG_V1=y
CONFIG_BLK_CGROUP_IOPRIO=y

# --- /proc/config.gz (VINTF reads it) ---------------------------------------
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# --- Syscalls and sandboxing (zygote, minijail, ART) ------------------------
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_USERFAULTFD=y
CONFIG_ANON_VMA_NAME=y
CONFIG_CROSS_MEMORY_ATTACH=y
CONFIG_POSIX_MQUEUE=y
CONFIG_DEFAULT_MMAP_MIN_ADDR=32768

# --- Memory management (lmkd, zram swap, dma-buf) ---------------------------
CONFIG_COMPACTION=y
CONFIG_MIGRATION=y
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_WRITEBACK=y
CONFIG_ZRAM_MULTI_COMP=y
CONFIG_CMA=y
CONFIG_CMA_SYSFS=y
CONFIG_DMA_CMA=y
CONFIG_CMA_SIZE_MBYTES=16
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_DMABUF_HEAPS_CMA=y
CONFIG_DMABUF_SYSFS_STATS=y
CONFIG_SYNC_FILE=y
CONFIG_SW_SYNC=y
# ASHMEM is Rust-only in this ACK (depends on RUST) and gekko has no rustc;
# Lineage 23 libcutils uses memfd instead (ashmem_compat_memfd_context.txt).

# --- Power management (suspend blockers) -----------------------------------
CONFIG_PM_WAKELOCKS=y
CONFIG_PM_WAKELOCKS_LIMIT=0
# CONFIG_PM_WAKELOCKS_GC is not set
CONFIG_THERMAL_GOV_USER_SPACE=y

# --- Block, device-mapper, filesystems --------------------------------------
# apexd writes to loop devices whose backing files are on mounted filesystems.
CONFIG_BLK_DEV_WRITE_MOUNTED=y
CONFIG_BLK_DEV_LOOP_MIN_COUNT=16
CONFIG_DM_UEVENT=y
CONFIG_DM_VERITY_FEC=y
CONFIG_DM_DEFAULT_KEY=y
CONFIG_DM_BOW=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_F2FS_FS_COMPRESSION=y
CONFIG_F2FS_FS_LZ4=y
CONFIG_F2FS_FS_ZSTD=y
CONFIG_FS_VERITY=y
CONFIG_UNICODE=y
CONFIG_QUOTA=y
CONFIG_QUOTA_NETLINK_INTERFACE=y
CONFIG_QFMT_V2=y
CONFIG_QUOTACTL=y
CONFIG_FUSE_FS=y
CONFIG_FUSE_PASSTHROUGH=y
CONFIG_FUSE_BPF=y
CONFIG_OVERLAY_FS=y
CONFIG_INCREMENTAL_FS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_MSDOS_FS=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_PSTORE_PMSG=y

# --- Crypto (fscrypt v2 already on; IPsec, zram, ARMv8 CE acceleration) -----
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_CCM=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_XCBC=y
CONFIG_CRYPTO_MD5=y
CONFIG_CRYPTO_DES=y
CONFIG_CRYPTO_CHACHA20POLY1305=y
CONFIG_CRYPTO_ECDH=y
CONFIG_CRYPTO_ADIANTUM=y
CONFIG_CRYPTO_HCTR2=y
CONFIG_CRYPTO_BLAKE2B=y
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_CRYPTO_GHASH_ARM64_CE=y
CONFIG_CRYPTO_SHA1_ARM64_CE=y
CONFIG_CRYPTO_SHA2_ARM64_CE=y
CONFIG_CRYPTO_SHA512_ARM64_CE=y
CONFIG_CRYPTO_POLYVAL_ARM64_CE=y
CONFIG_CRYPTO_AES_ARM64_CE_BLK=y

# --- Networking: netd, tethering, VPN, IPsec, clatd (android-base) --------
CONFIG_PACKET=y
CONFIG_XFRM_USER=y
CONFIG_XFRM_INTERFACE=y
CONFIG_XFRM_MIGRATE=y
CONFIG_XFRM_STATISTICS=y
CONFIG_NET_KEY=y
CONFIG_IP_MULTICAST=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_NET_IPIP=y
CONFIG_NET_IPGRE_DEMUX=y
CONFIG_NET_IPGRE=y
CONFIG_NET_IPVTI=y
CONFIG_INET_ESP=y
CONFIG_INET_UDP_DIAG=y
CONFIG_INET_DIAG_DESTROY=y
CONFIG_TCP_CONG_ADVANCED=y
# CONFIG_TCP_CONG_BIC is not set
# CONFIG_TCP_CONG_WESTWOOD is not set
# CONFIG_TCP_CONG_HTCP is not set
CONFIG_TCP_CONG_CUBIC=y
CONFIG_IPV6_ROUTER_PREF=y
CONFIG_IPV6_ROUTE_INFO=y
CONFIG_IPV6_OPTIMISTIC_DAD=y
CONFIG_INET6_ESP=y
CONFIG_INET6_IPCOMP=y
CONFIG_IPV6_MIP6=y
CONFIG_IPV6_VTI=y
CONFIG_IPV6_GRE=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_IPV6_MROUTE=y
CONFIG_IPV6_MROUTE_MULTIPLE_TABLES=y
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_SECMARK=y
CONFIG_NF_CONNTRACK_PROCFS=y
CONFIG_NF_CONNTRACK_EVENTS=y
CONFIG_NF_CONNTRACK_AMANDA=y
CONFIG_NF_CONNTRACK_FTP=y
CONFIG_NF_CONNTRACK_H323=y
CONFIG_NF_CONNTRACK_IRC=y
CONFIG_NF_CONNTRACK_NETBIOS_NS=y
CONFIG_NF_CONNTRACK_PPTP=y
CONFIG_NF_CONNTRACK_SANE=y
CONFIG_NF_CONNTRACK_TFTP=y
CONFIG_NF_CT_NETLINK=y
CONFIG_NETFILTER_XTABLES_COMPAT=y
CONFIG_NETFILTER_XT_TARGET_CLASSIFY=y
CONFIG_NETFILTER_XT_TARGET_CONNMARK=y
CONFIG_NETFILTER_XT_TARGET_CONNSECMARK=y
CONFIG_NETFILTER_XT_TARGET_DSCP=y
CONFIG_NETFILTER_XT_TARGET_IDLETIMER=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_TARGET_MARK=y
CONFIG_NETFILTER_XT_TARGET_NFLOG=y
CONFIG_NETFILTER_XT_TARGET_NFQUEUE=y
CONFIG_NETFILTER_XT_TARGET_NOTRACK=y
CONFIG_NETFILTER_XT_TARGET_TEE=y
CONFIG_NETFILTER_XT_TARGET_TPROXY=y
CONFIG_NETFILTER_XT_TARGET_TRACE=y
CONFIG_NETFILTER_XT_TARGET_SECMARK=y
CONFIG_NETFILTER_XT_TARGET_TCPMSS=y
CONFIG_NETFILTER_XT_MATCH_BPF=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_CONNBYTES=y
CONFIG_NETFILTER_XT_MATCH_CONNLIMIT=y
CONFIG_NETFILTER_XT_MATCH_CONNMARK=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_DSCP=y
CONFIG_NETFILTER_XT_MATCH_ESP=y
CONFIG_NETFILTER_XT_MATCH_HASHLIMIT=y
CONFIG_NETFILTER_XT_MATCH_HELPER=y
CONFIG_NETFILTER_XT_MATCH_IPRANGE=y
CONFIG_NETFILTER_XT_MATCH_L2TP=y
CONFIG_NETFILTER_XT_MATCH_LENGTH=y
CONFIG_NETFILTER_XT_MATCH_LIMIT=y
CONFIG_NETFILTER_XT_MATCH_MAC=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_OWNER=y
CONFIG_NETFILTER_XT_MATCH_POLICY=y
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=y
CONFIG_NETFILTER_XT_MATCH_QUOTA=y
CONFIG_NETFILTER_XT_MATCH_QUOTA2=y
CONFIG_NETFILTER_XT_MATCH_QUOTA2_LOG=y
CONFIG_NETFILTER_XT_MATCH_SOCKET=y
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_NETFILTER_XT_MATCH_STATISTIC=y
CONFIG_NETFILTER_XT_MATCH_STRING=y
CONFIG_NETFILTER_XT_MATCH_TIME=y
CONFIG_NETFILTER_XT_MATCH_U32=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_MATCH_ECN=y
CONFIG_IP_NF_MATCH_RPFILTER=y
CONFIG_IP_NF_MATCH_TTL=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_TARGET_NETMAP=y
CONFIG_IP_NF_TARGET_REDIRECT=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_RAW=y
CONFIG_IP_NF_SECURITY=y
CONFIG_IP_NF_ARPTABLES=y
CONFIG_IP_NF_ARPFILTER=y
CONFIG_IP_NF_ARP_MANGLE=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_MATCH_RPFILTER=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_TARGET_REJECT=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_RAW=y
CONFIG_L2TP=y
CONFIG_BRIDGE=y
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_HTB=y
CONFIG_NET_SCH_PRIO=y
CONFIG_NET_SCH_MULTIQ=y
CONFIG_NET_SCH_SFQ=y
CONFIG_NET_SCH_TBF=y
CONFIG_NET_SCH_NETEM=y
CONFIG_NET_SCH_CODEL=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_CLS_BASIC=y
CONFIG_NET_CLS_FW=y
CONFIG_NET_CLS_U32=y
CONFIG_CLS_U32_MARK=y
CONFIG_NET_CLS_FLOW=y
CONFIG_NET_CLS_CGROUP=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_CLS_MATCHALL=y
CONFIG_NET_EMATCH=y
CONFIG_NET_EMATCH_CMP=y
CONFIG_NET_EMATCH_NBYTE=y
CONFIG_NET_EMATCH_U32=y
CONFIG_NET_EMATCH_META=y
CONFIG_NET_EMATCH_TEXT=y
CONFIG_NET_CLS_ACT=y
CONFIG_NET_ACT_POLICE=y
CONFIG_NET_ACT_GACT=y
CONFIG_GACT_PROB=y
CONFIG_NET_ACT_MIRRED=y
CONFIG_NET_ACT_SKBEDIT=y
CONFIG_NET_ACT_BPF=y
CONFIG_NETDEVICES=y
CONFIG_DUMMY=y
CONFIG_IFB=y
CONFIG_TUN=y
CONFIG_VETH=y
CONFIG_PPP=y
CONFIG_PPP_BSDCOMP=y
CONFIG_PPP_DEFLATE=y
CONFIG_PPP_MPPE=y
CONFIG_PPTP=y
CONFIG_PPPOL2TP=y
CONFIG_BPF_JIT_ALWAYS_ON=y

# --- Input / HID (no input at all otherwise) --------------------------------
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_UINPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_GPIO=y
# PS/2 (default-on with INPUT_KEYBOARD) does not exist on this SoC.
# CONFIG_KEYBOARD_ATKBD is not set
# CONFIG_SERIO is not set
CONFIG_HID_SUPPORT=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_HIDRAW=y
CONFIG_UHID=y
CONFIG_RTC_CLASS=y

# --- Display core (inert until a DT node exists) ----------------------------
CONFIG_FB=y
CONFIG_FB_SIMPLE=y

# --- USB gadget functions used by the Android USB HAL / UsbDeviceManager ---
CONFIG_ANDROID_USB_CONFIGFS_UEVENT=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_EEM=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_CONFIGFS_F_HID=y
CONFIG_ANDROID_USB_CONFIGFS_F_ACC=y

# --- Hardening (android-base / android-base-conditional for arm64) ---------
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_ARM64_SW_TTBR0_PAN=y
CONFIG_ARMV8_DEPRECATED=y
CONFIG_SWP_EMULATION=y
CONFIG_CP15_BARRIER_EMULATION=y
CONFIG_SETEND_EMULATION=y
CONFIG_STATIC_USERMODEHELPER=y
CONFIG_STATIC_USERMODEHELPER_PATH=""
CONFIG_KFENCE=y

# --- Tracing / debugging (atrace, perfetto, bpfloader, bring-up) -----------
CONFIG_PROFILING=y
CONFIG_PERF_EVENTS=y
# ARM_PMU would bind the cortex-a55/mongoose PMU DT nodes: see the list below.
# CONFIG_ARM_PMU is not set
CONFIG_FTRACE=y
# CONFIG_FUNCTION_TRACER is not set
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_BPF_EVENTS=y
CONFIG_DEBUG_FS=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_KALLSYMS_ALL=y
CONFIG_PRINTK_TIME=y

# --- Kept OFF on purpose (risky on this hardware or unverified) -------------
# Generic Exynos drivers that would probe 9810 blocks with older-SoC
# assumptions, or that conflict with the ported 9810 drivers:
# CONFIG_EXYNOS_THERMAL is not set
# CONFIG_SCSI_UFS_EXYNOS is not set
# CONFIG_PHY_SAMSUNG_UFS is not set
# CONFIG_CRYPTO_DEV_EXYNOS_RNG is not set
# CONFIG_CRYPTO_DEV_S5P is not set
# CONFIG_I2C_S3C2410 is not set
# CONFIG_MFD_EXYNOS_LPASS is not set
# CONFIG_PHY_EXYNOS_PCIE is not set
# CONFIG_ARM_EXYNOS_BUS_DEVFREQ is not set
# CONFIG_PM_DEVFREQ_EVENT is not set
# CONFIG_INTERCONNECT is not set
# CONFIG_IOMMU_SUPPORT is not set
# Exynos9810 CL0 watchdog (guarded s3c2410 variant): kernel pings until
# userspace opens it, so a hung kernel resets to the normal BOOT image.
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y
CONFIG_WATCHDOG_OPEN_TIMEOUT=0
CONFIG_WATCHDOG_SYSFS=y
# CONFIG_WATCHDOG_NOWAYOUT is not set
CONFIG_S3C2410_WATCHDOG=y
# MAX77705 read-only battery monitor: battery/ac/usb/wireless power supplies
# for the health HAL from I2C reads only (never writes charger/fuel gauge).
CONFIG_BATTERY_MAX77705_RO=y
# Generic reset/poweroff drivers would take over the syscon-reboot/poweroff
# nodes from the hardware-verified crownlte diagnostic restart path:
# CONFIG_POWER_RESET_SYSCON is not set
# CONFIG_POWER_RESET_SYSCON_POWEROFF is not set
# Firmware may not preserve x18 across SMC/Trustonic calls; drivers may DMA
# from stack buffers; CFI/LTO untested with the ported drivers:
# CONFIG_SHADOW_CALL_STACK is not set
# CONFIG_VMAP_STACK is not set
# CONFIG_CFI_CLANG is not set
# CONFIG_RANDOMIZE_BASE is not set
# The cpuidle work lives on crownlte-cpuidle (not yet hardware-verified):
# CONFIG_CPU_IDLE is not set
# Not needed, and would change the hardware-verified UFS/USB paths:
# CONFIG_SCSI_SCAN_ASYNC is not set
# CONFIG_PCI is not set
# CONFIG_MODULES is not set

# exynos-clkout: generic Exynos clock-output driver; fails probe (-22) on 9810 DT. Off.
# CONFIG_EXYNOS_CLKOUT is not set

# MIF/INT bus DVFS over CAL/ACPM (hardware-verified q15/q18).
CONFIG_ARM_EXYNOS9810_ACPM_DEVFREQ=y
