/dts-v1/;

/ {
	compatible = "samsung,crownlte", "samsung,exynos9810";
	#address-cells = <0x02>;
	#size-cells = <0x01>;
	interrupt-parent = <0x01>;
	model = "Samsung Note9 ROM-in-RAM v4 (integration-2 + display flipfix)";
	chassis-type = "handset";
	model_info-chip = <0x2652>;
	model_info-platform = "android";
	model_info-subtype = "samsung";
	model_info-hw_rev = <0x1a>;
	model_info-system_rev = "028";
	model_info-hw_rev_end = <0xff>;

	aliases {
		pinctrl0 = "/soc@0/pinctrl@14050000";
		pinctrl1 = "/soc@0/pinctrl@17c60000";
		pinctrl2 = "/soc@0/pinctrl@13a80000";
		pinctrl3 = "/soc@0/pinctrl@14220000";
		pinctrl4 = "/soc@0/pinctrl@11050000";
		pinctrl5 = "/soc@0/pinctrl@11430000";
		pinctrl6 = "/soc@0/pinctrl@10430000";
		pinctrl7 = "/soc@0/pinctrl@10830000";
		pinctrl8 = "/soc@0/pinctrl@13880000";
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x02>;
				};

				core1 {
					cpu = <0x03>;
				};

				core2 {
					cpu = <0x04>;
				};

				core3 {
					cpu = <0x05>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0x06>;
				};

				core1 {
					cpu = <0x07>;
				};

				core2 {
					cpu = <0x08>;
				};

				core3 {
					cpu = <0x09>;
				};
			};
		};

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x00>;
			enable-method = "psci";
			cpu-idle-states = <0x0a>;
			#cooling-cells = <0x02>;
			phandle = <0x02>;
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x01>;
			enable-method = "psci";
			cpu-idle-states = <0x0a>;
			#cooling-cells = <0x02>;
			phandle = <0x03>;
		};

		cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x02>;
			enable-method = "psci";
			cpu-idle-states = <0x0a>;
			#cooling-cells = <0x02>;
			phandle = <0x04>;
		};

		cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x03>;
			enable-method = "psci";
			cpu-idle-states = <0x0a>;
			#cooling-cells = <0x02>;
			phandle = <0x05>;
		};

		cpu@100 {
			device_type = "cpu";
			compatible = "samsung,mongoose-m3";
			reg = <0x100>;
			enable-method = "psci";
			cpu-idle-states = <0x0b>;
			#cooling-cells = <0x02>;
			phandle = <0x06>;
		};

		cpu@101 {
			device_type = "cpu";
			compatible = "samsung,mongoose-m3";
			reg = <0x101>;
			enable-method = "psci";
			cpu-idle-states = <0x0b>;
			#cooling-cells = <0x02>;
			phandle = <0x07>;
		};

		cpu@102 {
			device_type = "cpu";
			compatible = "samsung,mongoose-m3";
			reg = <0x102>;
			enable-method = "psci";
			cpu-idle-states = <0x0b>;
			#cooling-cells = <0x02>;
			phandle = <0x08>;
		};

		cpu@103 {
			device_type = "cpu";
			compatible = "samsung,mongoose-m3";
			reg = <0x103>;
			enable-method = "psci";
			cpu-idle-states = <0x0b>;
			#cooling-cells = <0x02>;
			phandle = <0x09>;
		};

		idle-states {

			c2-little {
				compatible = "samsung,exynos9810-idle-state";
				idle-state-name = "c2";
				arm,psci-suspend-param = <0x10000>;
				entry-latency-us = <0x46>;
				exit-latency-us = <0xa0>;
				min-residency-us = <0x7d0>;
				local-timer-stop;
				phandle = <0x0a>;
			};

			c2-big {
				compatible = "samsung,exynos9810-idle-state";
				idle-state-name = "c2";
				arm,psci-suspend-param = <0x10000>;
				entry-latency-us = <0xeb>;
				exit-latency-us = <0xdc>;
				min-residency-us = <0xdac>;
				local-timer-stop;
				phandle = <0x0b>;
			};
		};
	};

	osc-clock {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-output-names = "oscclk";
		clock-frequency = <0x18cba80>;
	};

	pmu-a55 {
		compatible = "arm,cortex-a55-pmu";
		interrupts = <0x00 0x90 0x04 0x00 0x91 0x04 0x00 0x92 0x04 0x00 0x93 0x04>;
		interrupt-affinity = <0x02 0x03 0x04 0x05>;
	};

	pmu-mongoose-m3 {
		compatible = "samsung,mongoose-pmu";
		interrupts = <0x00 0xa7 0x04 0x00 0xa8 0x04 0x00 0xa9 0x04 0x00 0xaa 0x04>;
		interrupt-affinity = <0x06 0x07 0x08 0x09>;
	};

	psci {
		compatible = "arm,psci";
		method = "smc";
		cpu_off = <0x84000002>;
		cpu_on = <0xc4000003>;
		cpu_suspend = <0xc4000001>;
	};

	soc@0 {
		compatible = "simple-bus";
		ranges = <0x00 0x00 0x00 0x20000000>;
		#address-cells = <0x01>;
		#size-cells = <0x01>;

		chipid@10000000 {
			compatible = "samsung,exynos9810-chipid", "samsung,exynos850-chipid";
			reg = <0x10000000 0x100>;
		};

		timer@10040000 {
			compatible = "samsung,exynos9810-mct-broadcast";
			reg = <0x10040000 0x800>;
			interrupts = <0x00 0x1d2 0x04>;
			status = "okay";
			clocks = <0x0c 0x98>;
			clock-names = "mct";
			samsung,mct-bc-report;
		};

		watchdog@10050000 {
			compatible = "samsung,exynos9810-wdt";
			reg = <0x10050000 0x100>;
			interrupts = <0x00 0x1d0 0x04>;
			samsung,syscon-phandle = <0x0d>;
			status = "okay";
			clocks = <0x0c 0x01>;
			clock-names = "watchdog";
			timeout-sec = <0x1e>;
			samsung,start-at-boot;
		};

		interrupt-controller@10101000 {
			compatible = "arm,gic-400";
			reg = <0x10101000 0x1000 0x10102000 0x1000 0x10104000 0x2000 0x10106000 0x2000>;
			#interrupt-cells = <0x03>;
			interrupt-controller;
			interrupts = <0x01 0x09 0xff04>;
			#address-cells = <0x00>;
			#size-cells = <0x01>;
			phandle = <0x01>;
		};

		pinctrl@10430000 {
			compatible = "samsung,exynos9810-pinctrl";
			reg = <0x10430000 0x1000>;
			interrupts = <0x00 0x18c 0x04>;

			gpg0-gpio-bank {
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
			};

			gpg1-gpio-bank {
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
			};

			gpg2-gpio-bank {
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
			};

			gpp0-gpio-bank {
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
			};

			gpp1-gpio-bank {
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
			};

			gpp2-gpio-bank {
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
			};

			gpp3-gpio-bank {
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
			};

			hsi2c10-bus-pins {
				samsung,pins = "gpp1-4", "gpp1-5";
				samsung,pin-function = <0x02>;
				samsung,pin-pud = <0x00>;
				samsung,pin-drv = <0x00>;
				phandle = <0x13>;
			};
		};

		pinctrl@10830000 {
			compatible = "samsung,exynos9810-pinctrl";
			reg = <0x10830000 0x1000>;
			interrupts = <0x00 0x1a5 0x04>;

			gpc0-gpio-bank {
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
			};

			gpc1-gpio-bank {
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
			};

			gpd0-gpio-bank {
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
				phandle = <0x23>;
			};

			gpg3-gpio-bank {
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
			};

			gpp4-gpio-bank {
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
			};

			gpp5-gpio-bank {
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
			};

			gpp6-gpio-bank {
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
			};
		};

		pinctrl@11050000 {
			compatible = "samsung,exynos9810-pinctrl";
			reg = <0x11050000 0x1000>;
			interrupts = <0x00 0xf3 0x04>;

			gpf0-gpio-bank {
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
			};
		};

		pinctrl@11430000 {
			compatible = "samsung,exynos9810-pinctrl";
			reg = <0x11430000 0x1000>;
			interrupts = <0x00 0xfa 0x04>;

			gpf1-gpio-bank {
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
			};

			gpf2-gpio-bank {
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
			};
		};

		pinctrl@13880000 {
			compatible = "samsung,exynos9810-pinctrl";
			reg = <0x13880000 0x1000>;

			gpt0-gpio-bank {
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
			};
		};

		pinctrl@13a80000 {
			compatible = "samsung,exynos9810-pinctrl";
			reg = <0x13a80000 0x1000>;
			interrupts = <0x00 0x6d 0x04>;

			gph0-gpio-bank {
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
			};

			gph1-gpio-bank {
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
			};
		};

		pinctrl@14050000 {
			compatible = "samsung,exynos9810-pinctrl";
			reg = <0x14050000 0x1000>;

			wakeup-interrupt-controller {
				compatible = "samsung,exynos9810-wakeup-eint", "samsung,exynos850-wakeup-eint", "samsung,exynos7-wakeup-eint";
			};

			etc1-gpio-bank {
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
			};

			gpa0-gpio-bank {
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				interrupt-parent = <0x01>;
				interrupts = <0x00 0x24 0x04 0x00 0x25 0x04 0x00 0x26 0x04 0x00 0x27 0x04 0x00 0x28 0x04 0x00 0x29 0x04 0x00 0x2a 0x04 0x00 0x2b 0x04>;
				#interrupt-cells = <0x02>;
			};

			gpa1-gpio-bank {
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				interrupt-parent = <0x01>;
				interrupts = <0x00 0x2c 0x04 0x00 0x2d 0x04 0x00 0x2e 0x04 0x00 0x2f 0x04 0x00 0x30 0x04 0x00 0x31 0x04 0x00 0x32 0x04 0x00 0x33 0x04>;
				#interrupt-cells = <0x02>;
				phandle = <0x14>;
			};

			gpa2-gpio-bank {
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				interrupt-parent = <0x01>;
				interrupts = <0x00 0x34 0x04 0x00 0x35 0x04 0x00 0x36 0x04 0x00 0x37 0x04 0x00 0x38 0x04 0x00 0x39 0x04 0x00 0x3a 0x04 0x00 0x3b 0x04>;
				#interrupt-cells = <0x02>;
			};

			gpa3-gpio-bank {
				gpio-controller;
				phandle = <0x26>;
				#gpio-cells = <0x02>;
				interrupt-controller;
				interrupt-parent = <0x01>;
				interrupts = <0x00 0x3c 0x04 0x00 0x3d 0x04 0x00 0x3e 0x04 0x00 0x3f 0x04 0x00 0x40 0x04 0x00 0x41 0x04 0x00 0x42 0x04 0x00 0x43 0x04>;
				#interrupt-cells = <0x02>;
			};

			gpa4-gpio-bank {
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
			};

			gpq0-gpio-bank {
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
			};

			touch-irq-pins {
				samsung,pins = "gpa1-0";
				samsung,pin-function = <0x0f>;
				samsung,pin-pud = <0x00>;
				samsung,pin-drv = <0x00>;
				phandle = <0x15>;
			};
		};

		system-controller@14060000 {
			compatible = "samsung,exynos9810-pmu", "samsung,exynos7-pmu", "syscon";
			reg = <0x14060000 0x10000>;
			phandle = <0x0d>;

			syscon-poweroff {
				compatible = "syscon-poweroff";
				regmap = <0x0d>;
				offset = <0x330c>;
				mask = <0x5200>;
			};

			syscon-reboot {
				compatible = "syscon-reboot";
				regmap = <0x0d>;
				offset = <0x400>;
				mask = <0x01>;
			};
		};

		cpuidle@14070000 {
			compatible = "samsung,exynos9810-cpuidle";
			reg = <0x14070000 0x1000>;
			samsung,pmu-syscon = <0x0d>;
			status = "okay";
		};

		pinctrl@14220000 {
			compatible = "samsung,exynos9810-pinctrl";
			reg = <0x14220000 0x1000>;

			wakeup-interrupt-controller {
				compatible = "samsung,exynos9810-wakeup-eint", "samsung,exynos850-wakeup-eint", "samsung,exynos7-wakeup-eint";
			};

			gpm0-gpio-bank {
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
				interrupts = <0x00 0x09 0x04>;
			};

			gpm1-gpio-bank {
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
				interrupts = <0x00 0x0a 0x04>;
			};

			gpm2-gpio-bank {
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
				interrupts = <0x00 0x0b 0x04>;
			};

			gpm3-gpio-bank {
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
				interrupts = <0x00 0x0c 0x04>;
			};

			gpm4-gpio-bank {
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
				interrupts = <0x00 0x0d 0x04>;
			};

			gpm5-gpio-bank {
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
				interrupts = <0x00 0x0e 0x04>;
			};

			gpm6-gpio-bank {
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
				interrupts = <0x00 0x0f 0x04>;
			};

			gpm7-gpio-bank {
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
				interrupts = <0x00 0x10 0x04>;
			};

			gpm10-gpio-bank {
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
				interrupts = <0x00 0x11 0x04>;
			};

			gpm11-gpio-bank {
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
				interrupts = <0x00 0x12 0x04>;
			};

			gpm12-gpio-bank {
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
				interrupts = <0x00 0x13 0x04>;
			};

			gpm13-gpio-bank {
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
				interrupts = <0x00 0x14 0x04>;
			};

			gpm14-gpio-bank {
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
				interrupts = <0x00 0x15 0x04>;
			};

			gpm15-gpio-bank {
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
				interrupts = <0x00 0x16 0x04>;
			};

			gpm16-gpio-bank {
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
				interrupts = <0x00 0x17 0x04>;
			};

			gpm17-gpio-bank {
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
				interrupts = <0x00 0x18 0x04>;
			};

			gpm40-gpio-bank {
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
				interrupts = <0x00 0x19 0x04>;
			};

			gpm41-gpio-bank {
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
				interrupts = <0x00 0x1a 0x04>;
			};

			gpm42-gpio-bank {
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
				interrupts = <0x00 0x1b 0x04>;
			};

			gpm43-gpio-bank {
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
				interrupts = <0x00 0x1c 0x04>;
			};

			hsi2c40-bus-pins {
				samsung,pins = "gpm14-0", "gpm15-0";
				samsung,pin-function = <0x02>;
				samsung,pin-pud = <0x00>;
				samsung,pin-drv = <0x00>;
				phandle = <0x17>;
			};
		};

		sysmmu@160a0000 {
			compatible = "samsung,exynos-sysmmu";
			reg = <0x160a0000 0x9000>;
			interrupts = <0x00 0xd3 0x04>;
			#iommu-cells = <0x00>;
			status = "disabled";
		};

		sysmmu@160b0000 {
			compatible = "samsung,exynos-sysmmu";
			reg = <0x160b0000 0x9000>;
			interrupts = <0x00 0xd5 0x04>;
			#iommu-cells = <0x00>;
			status = "disabled";
		};

		sysmmu@160c0000 {
			compatible = "samsung,exynos-sysmmu";
			reg = <0x160c0000 0x9000>;
			interrupts = <0x00 0xd7 0x04>;
			#iommu-cells = <0x00>;
			status = "disabled";
		};

		gpu@17500000 {
			compatible = "samsung,exynos9810-mali", "arm,mali-bifrost";
			reg = <0x17500000 0x5000 0x17400000 0x1000>;
			interrupts = <0x00 0x11a 0x04 0x00 0x119 0x04 0x00 0x11b 0x04>;
			interrupt-names = "JOB", "MMU", "GPU";
			samsung,pmu-syscon = <0x0d>;
			samsung,cal-id = <0xb040004>;
			samsung,g3d-pd-cal-id = <0xb1380008>;
