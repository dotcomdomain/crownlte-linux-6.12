				big-critical {
					temperature = <0x1adb0>;
					hysteresis = <0x00>;
					type = "critical";
				};
			};

			cooling-maps {

				map0 {
					trip = <0x1d>;
					cooling-device = <0x06 0xffffffff 0xffffffff 0x07 0xffffffff 0xffffffff 0x08 0xffffffff 0xffffffff 0x09 0xffffffff 0xffffffff>;
				};
			};
		};

		LITTLE {
			polling-delay-passive = <0x00>;
			polling-delay = <0x3e8>;
			thermal-sensors = <0x1e>;

			trips {

				little-critical {
					temperature = <0x1adb0>;
					hysteresis = <0x00>;
					type = "critical";
				};
			};
		};

		G3D {
			polling-delay-passive = <0x64>;
			polling-delay = <0x3e8>;
			thermal-sensors = <0x1f>;

			trips {

				gpu-control-temp {
					temperature = <0x157c0>;
					hysteresis = <0x1388>;
					type = "passive";
					phandle = <0x20>;
				};

				gpu-critical {
					temperature = <0x1adb0>;
					hysteresis = <0x00>;
					type = "critical";
				};
			};

			cooling-maps {

				map0 {
					trip = <0x20>;
					cooling-device = <0x21 0xffffffff 0xffffffff>;
				};
			};
		};

		ISP {
			polling-delay-passive = <0x00>;
			polling-delay = <0x3e8>;
			thermal-sensors = <0x22>;

			trips {

				isp-critical {
					temperature = <0x1adb0>;
					hysteresis = <0x00>;
					type = "critical";
				};
			};
		};
	};

	cpufreq {
		compatible = "samsung,exynos9810-acpm-cpufreq";
		samsung,mif-devfreq = <0x0e>;

		cluster0 {
			cpus = <0x02 0x03 0x04 0x05>;
			samsung,cal-id = <0xb040002>;
			min-freq = <0x6f158>;
			max-freq = <0x1dc130>;
			samsung,mif-ect-domain = "dvfs_cpucl0";
			samsung,mif-perf-table = <0x1dc130 0xce4c8 0x1b5fd0 0xce4c8 0x19c990 0xce4c8 0x163780 0xa50a0 0x130b00 0xa50a0 0x101148 0xa50a0 0xe7b08 0xa50a0 0xcb200 0x854d0 0xae8f8 0x854d0 0x91ff0 0x66c88 0x6f158 0x00>;
		};

		cluster1 {
			cpus = <0x06 0x07 0x08 0x09>;
			samsung,cal-id = <0xb040003>;
			min-freq = <0x9eb10>;
			max-freq = <0x234f10>;
			policy-max = <0x1b5fd0>;
			samsung,max-freq-cap = <0x1b5fd0>;
			samsung,mif-ect-domain = "dvfs_cpucl1";
			samsung,mif-perf-table = <0x2c0970 0x1b5fd0 0x2ba3e0 0x1b5fd0 0x294280 0x1b5fd0 0x287760 0x1b5fd0 0x261600 0x1b5fd0 0x234f10 0x1b5fd0 0x202290 0x1b5fd0 0x1e8c50 0x1b5fd0 0x1d5ba0 0x1b5fd0 0x1b5fd0 0x1b5fd0 0x19c990 0x177bb8 0x183350 0xf78f0 0x166a48 0xce4c8 0x133dc8 0xa50a0 0x11da50 0xa50a0 0x104410 0xa50a0 0xeadd0 0x854d0 0xd1790 0x854d0 0xb4e88 0x66c88 0x9eb10 0x66c88 0x91ff0 0x66c88>;
		};
	};

	decon_f@16030000 {
		compatible = "samsung,exynos9810-decon";
		reg = <0x00 0x16030000 0x10000 0x00 0x16071000 0x6000 0x00 0x16021000 0x6000 0x00 0x16070000 0x1000 0x00 0x160a0000 0x1000 0x00 0x160b0000 0x1000 0x00 0x160c0000 0x1000 0x00 0x16080000 0x100>;
		reg-names = "decon", "dpp-dma", "dpp", "dma-common", "sysmmu0", "sysmmu1", "sysmmu2", "dsim";
		interrupts-extended = <0x01 0x00 0xb6 0x04 0x01 0x00 0xb7 0x04 0x01 0x00 0xbc 0x04 0x23 0x00 0x01>;
		interrupt-names = "frame_start", "frame_done", "extra", "te";
		samsung,pmu-syscon = <0x0d>;
		samsung,boot-fb = <0x0f>;
		memory-region = <0x24>;
		samsung,decon-trigger = "hw-te";
		samsung,fb-takeover;
		samsung,lcd-fps = <0x3c>;
		samsung,lcd-width-mm = <0x45>;
		samsung,lcd-height-mm = <0x8e>;
		samsung,dsc-enabled;
		samsung,dsc-slice-width = <0x2d0>;
		samsung,dsc-slice-height = <0x28>;
		samsung,panel = <0x25>;
	};

	panel_drv@001 {
		compatible = "samsung,exynos9810-panel-readonly";
		samsung,boot-brightness = <0x3200>;
		samsung,max-brightness = <0xae9c>;
		samsung,fault-display-brightness = <0xae9c>;
		samsung,fault-display-brightness-at-ms = <0x3e8>;
		samsung,panel-status-key2;
		samsung,panel-recovery-level = <0x02>;
		samsung,panel-reset-gpios = <0x26 0x04 0x00>;
		samsung,panel-recovery-at-ms = <0x1f40>;
		samsung,panel-recovery-only-on-elvdd-error;
		samsung,panel-id = [91 20 47];
		samsung,hbm-gamma-expect = [07 38 30 39 79 79 79 7a 7a 7a 7e 7e 7e 7d 7f 7d 80 7f 81 7e 7f 7d 72 6f 72 70 75 72 57 36 4a 00 00 00];
		phandle = <0x25>;
	};
};

/* v23a: v22a plus read-only S2DOS05 snapshots on dedicated CMGP I2C02.
 * 4.9: hsi2c39 @14350000, rate95/gate105, gpm12/13 function 3.
 * This is NOT USI_CMGP02 @14340000 (which uses a different rate/gate).
 * Its SW_CONF @14212024 was disabled in 4.9; leave it untouched.
 */
&{/soc@0/pinctrl@14220000} {
	s2dos05_diag_pins: hsi2c39-bus-pins {
		samsung,pins = "gpm12-0", "gpm13-0";
		samsung,pin-function = <3>;
		samsung,pin-pud = <0>;
		samsung,pin-drv = <0>;
	};
};

&{/soc@0} {
	usi@143500c0 {
		compatible = "samsung,exynos9810-i2c-wrapper";
		reg = <0x143500c0 0x20>;
		clocks = <&{/clock-controller@15a80000} 105
			  &{/clock-controller@15a80000} 95>;
		clock-names = "pclk", "ipclk";
		samsung,clkreq-on;
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;
		status = "okay";

		i2c@14350000 {
			compatible = "samsung,exynos9810-hsi2c";
			reg = <0x14350000 0xc0>;
			interrupts = <0 5 4>;
			#address-cells = <1>;
			#size-cells = <0>;
			clocks = <&{/clock-controller@15a80000} 95
				  &{/clock-controller@15a80000} 105>;
			clock-names = "hsi2c", "hsi2c_pclk";
			clock-frequency = <100000>;
			pinctrl-names = "default";
			pinctrl-0 = <&s2dos05_diag_pins>;
			status = "okay";

			pmic-diagnostic@60 {
				compatible = "samsung,crownlte-s2dos05-diag";
				reg = <0x60>;
			};
		};
	};
};
