/* Actual crownlte live DT resources. Disabled until firmware bring-up. */
#include <dt-bindings/clock/exynos9810.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/soc/samsung,exynos-usi.h>
/ {
	/*
	 * S2MPS18 main PMIC (4.9: speedy@141C0000/s2mps18mfd@00 with
	 * acpm-ipc-channel = <2>). Every register access is an ACPM channel-2
	 * request; the APM firmware drives SPEEDY. Read-only unless
	 * samsung,rtc-read-latch / samsung,rtc-write-enable open the RTC block
	 * (never TOP/PMIC). PMIC IRQ = gpa0-1 (4.9 s2mps18,irq-gpio), unused.
	 */
	s2mps18_pmic: s2mps18-pmic {
		compatible = "samsung,exynos9810-s2mps18-acpm";
		acpm-ipc-channel = <2>;
		status = "disabled";
	};
	/* Original crownlte S2MPS18 firmware transport channel, not an I2C device. */
	legacy_acpm_pmic: acpm-pmic-client {
		compatible = "samsung,exynos9810-acpm-pmic-client";
		acpm-ipc-channel = <2>;
		status = "disabled";
	};
	legacy_cmu_ewf: cmu-ewf@1a240000 {
		compatible = "samsung,exynos-cmuewf";
		reg = <0 0x1a240000 0x1000>;
		status = "disabled";
	};
	legacy_osc: exynos9810-oscclk {
		compatible = "samsung,exynos9810-oscclk";
		clock-frequency = <26000000>;
	};
	legacy_cmu: clock-controller@15a80000 {
		compatible = "samsung,exynos9810-clock";
		reg = <0 0x15a80000 0x8000>;
		#clock-cells = <1>;
		status = "disabled";
	};
	legacy_acpm: acpm@14020000 {
		compatible = "samsung,exynos-acpm";
		reg = <0 0x14020000 0x1000>;
		reg-names = "timer_apm";
		acpm-ipc-channel = <4>;
		fvmap_offset = <0x6700>;
		peritimer-cnt = <0xffff>;
		status = "disabled";
	};
	legacy_acpm_ipc: acpm-ipc@14100000 {
		compatible = "samsung,exynos-acpm-ipc";
		reg = <0 0x14100000 0x1000>, <0 0x02039000 0x30000>;
		interrupt-parent = <&gic>;
		interrupts = <GIC_SPI 68 IRQ_TYPE_LEVEL_HIGH>;
		initdata-base = <0x7f00>;
		dump-base = <0x0203c000>;
		dump-size = <0x1d000>;
		logging-period = <500>;
		num-timestamps = <32>;
		debug-log-level = <0>;
		status = "disabled";
	};
	legacy_acpm_dvfs: acpm-dvfs {
		compatible = "samsung,exynos-acpm-dvfs";
		acpm-ipc-channel = <5>;	/* firmware MIF-floor notifications */
		status = "disabled";

		command {
			acpm-ipc-channel = <0>;	/* FREQ_REQ/FREQ_GET/MARGIN_REQ, as 4.9 */
		};
	};

	/*
	 * MIF/INT bus DVFS, from 4.9 crownlte_eur_open_26 devfreq_mif@17000010
	 * and devfreq_int@17000020 (gov_name "interactive", use_acpm, no PPMU).
	 * samsung,freq-info is 4.9 freq_info verbatim, in kHz:
	 *   <initial default-floor suspend min max reboot>
	 * CAL's boot and resume rates replace initial/suspend, as in 4.9.
	 * samsung,boot-qos is 4.9 boot_info <seconds kHz>; MIF down-delay is
	 * delay_time_list. acpm-ipc-channel is the firmware FVP channel used
	 * for the MIF->INT table upload and the sleep RELEASE flag.
	 * CPU/GPU/display consumers raise floors with dev_pm_qos
	 * DEV_PM_QOS_MIN_FREQUENCY on these devices, e.g. a cpufreq node with
	 * samsung,mif-devfreq = <&legacy_devfreq_mif>.
	 */
	legacy_devfreq_mif: devfreq-mif {
		compatible = "samsung,exynos9810-acpm-devfreq";
		samsung,devfreq-type = <0>;		/* 4.9 DEVFREQ_MIF */
		samsung,cal-id = <0x0b040000>;		/* dvfs_mif, 4.9 dfs_id */
		samsung,ect-domain = "dvfs_mif";
		samsung,freq-info = <2093000 208000 1014000 208000 2093000 2093000>;
		samsung,boot-qos = <40 1794000>;
		samsung,down-delay-ms = <20>;
		acpm-ipc-channel = <1>;
		samsung,fvp-constraint-upload;
		samsung,acpm-mif-notify;
		samsung,dependent-devfreq = <&legacy_devfreq_int>;
		status = "disabled";
	};

	legacy_devfreq_int: devfreq-int {
		compatible = "samsung,exynos9810-acpm-devfreq";
		samsung,devfreq-type = <1>;		/* 4.9 DEVFREQ_INT */
		samsung,cal-id = <0x0b040001>;		/* dvfs_int, 4.9 dfs_id */
		samsung,ect-domain = "dvfs_int";
		samsung,freq-info = <667000 178000 107000 107000 667000 667000>;
		samsung,boot-qos = <40 667000>;
		acpm-ipc-channel = <1>;
		status = "disabled";
	};
};

/ {
	/*
	 * Trustonic Kinibi TEE (4.9 exynos9810-crownlte_eur_open_26.dts:10318
	 * "tee" node, verbatim): S-SIQ notification interrupt SPI 233, flags 0;
	 * the driver requests it IRQF_TRIGGER_RISING, as on 4.9. Probing this
	 * node starts the TEE MCI exactly like the 4.9 boot (MEM_TRACE, INIT,
	 * N_SIQ, INFO/YIELD poll, MCP GET_MOBICORE_VERSION, SWAP_CPU to CPU1).
	 * No TA is loaded and nothing touches secure storage until a userspace
	 * daemon opens /dev/mobicore. Do NOT add 4.9 "ufs-srpmb" (SPI 460, the
	 * RPMB relay for the secure world) or "seclog" here.
	 */
	trustonic_tee: tee {
		compatible = "samsung,exynos-tee";
		interrupts = <GIC_SPI 233 IRQ_TYPE_NONE>;
		status = "disabled";
	};
};

/*
 * Touchscreen bus: PERIC0 USI03 as HSI2C (4.9 alias hsi2c10 = hsi2c@104B0000,
 * SPI 404, pins gpp1-4/gpp1-5 function 2, clocks rate 224 = USI03 and
 * gate 205 = GATE_USI03, fast mode 400 kHz default). The USI03 protocol
 * selector is PERIC0 SYSREG +0x101c (4.9 usi@1041101C usi_v2_mode "i2c",
 * value I2C_SW_CONF = BIT(2)). 4.9 also set samsung,stop-after-trans and
 * samsung,reset-before-trans on this bus; the touch driver reproduces the
 * former by issuing opcode and data as separate transfers.
 */
&pinctrl_peric0 {
	hsi2c10_bus: hsi2c10-bus-pins {
		samsung,pins = "gpp1-4", "gpp1-5";
		samsung,pin-function = <2>;
		samsung,pin-pud = <0>;
		samsung,pin-drv = <0>;
	};
};

/* 4.9 attn-irq "on_state": gpa1-0 EINT, no pull, drive 0. */
&pinctrl_alive {
	touch_irq: touch-irq-pins {
		samsung,pins = "gpa1-0";
		samsung,pin-function = <0xf>;
		samsung,pin-pud = <0>;
		samsung,pin-drv = <0>;
	};
};

&soc {
	usi_peric0_03_sysreg: syscon@1041101c {
		compatible = "samsung,exynos9810-peric0-usi-sysreg", "syscon";
		reg = <0x1041101c 0x4>;
	};

	usi_touch: usi@104b00c0 {
		compatible = "samsung,exynos9810-usi";
		/* Wrapper owns +0xc4/+0xc8; the HSI2C below owns [0, 0xc0). */
		reg = <0x104b00c0 0x20>;
		clocks = <&legacy_cmu GATE_USI03>, <&legacy_cmu USI03>;
		clock-names = "pclk", "ipclk";
		samsung,sysreg = <&usi_peric0_03_sysreg 0>;
		samsung,mode = <USI_V2_I2C>;
		samsung,clkreq-on;
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;
		status = "disabled";

		hsi2c_touch: i2c@104b0000 {
			compatible = "samsung,exynos9810-hsi2c";
			reg = <0x104b0000 0xc0>;
			interrupts = <GIC_SPI 404 IRQ_TYPE_LEVEL_HIGH>;
			#address-cells = <1>;
			#size-cells = <0>;
			clocks = <&legacy_cmu USI03>, <&legacy_cmu GATE_USI03>;
			clock-names = "hsi2c", "hsi2c_pclk";
			clock-frequency = <400000>;
			pinctrl-names = "default";
			pinctrl-0 = <&hsi2c10_bus>;
			status = "disabled";

			/*
			 * 4.9 touchscreen@48 "sec,sec_ts": sec,irq_gpio gpa1-0,
			 * sec,irq_type 0x2008 (level low, oneshot), supplies
			 * S2MPS18 LDO35 "tsp_io" 1.8 V and LDO43 "tsp_avdd"
			 * 3.0 V (both regulator-boot-on). No supplies here:
			 * there is no regulator driver, the bootloader must
			 * leave the IC powered. Never flashes firmware.
			 */
			touchscreen: touchscreen@48 {
				compatible = "samsung,sec-ts-y771";
				reg = <0x48>;
				interrupt-parent = <&gpa1>;
				interrupts = <0 IRQ_TYPE_LEVEL_LOW>;
				irq-gpios = <&gpa1 0 GPIO_ACTIVE_LOW>;
				pinctrl-names = "default";
				pinctrl-0 = <&touch_irq>;
				touchscreen-size-x = <1440>;
				touchscreen-size-y = <2960>;
				status = "disabled";
			};
		};
	};
};
